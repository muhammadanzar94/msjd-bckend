# Copy to ~/masjid/.env on the VM and fill in real values.
DB_NAME=msjd_db
DB_USER=msjd_user
DB_PASSWORD=same-password-you-passed-to-provision-vm.sh
DB_HOST=localhost
DB_PORT=3306

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-real-random-secret

DEBUG=False

# No domain yet? Use nip.io — it's free wildcard DNS that maps
# anything.<your-ip-with-dashes>.nip.io straight to your server, so
# subdomain-based masjid pages work exactly like they will with a real
# domain later. E.g. if your static IP is 34.123.45.67:
#   ALLOWED_HOSTS=127.0.0.1,34-123-45-67.nip.io,.34-123-45-67.nip.io
#   BASE_DOMAIN=34-123-45-67.nip.io
# Switch the domain parts to your real domain once you buy one — nothing
# else changes. 127.0.0.1 must always stay in ALLOWED_HOSTS regardless of
# domain: the frontend's server-to-server calls hit Django at
# http://127.0.0.1:8000 directly (see DJANGO_API_URL in the frontend's
# .env.local), so that Host header needs to be allowed too, separately
# from whatever public domain browsers use via nginx.
ALLOWED_HOSTS=127.0.0.1,yourdomain-or-nipio-host,.yourdomain-or-nipio-host
BASE_DOMAIN=yourdomain-or-nipio-host

# Required — without this, every image/logo/video URL in API responses
# comes back as http://127.0.0.1:8000/media/... (meaningless to an actual
# browser), since Django builds those URLs from whatever Host the request
# arrived with, and the frontend's server-to-server calls always use
# 127.0.0.1. Same host as BASE_DOMAIN, but a full scheme+host URL — no
# trailing slash, and http:// (not https://) until SSL is set up.
PUBLIC_BASE_URL=http://yourdomain-or-nipio-host
